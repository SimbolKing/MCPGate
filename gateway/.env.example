# gateway/ 服务私有环境变量
# 复制为 gateway/.env 后生效；共享变量（MCPGATE_*）请在仓库根目录 .env 中设置。

# --- Higress（all-in-one）---
# 安装时建议用 docker image inspect --format '{{index .RepoDigests 0}}' 替换为 digest 形式，避免 latest 漂移
HIGRESS_IMAGE=higress-registry.cn-hangzhou.cr.aliyuncs.com/higress/all-in-one:latest
# gateway 不启动控制台；需要控制台查看路由与插件时改为 full
HIGRESS_MODE=gateway
# Envoy 工作线程数（内存占用较高时可降为 1）
HIGRESS_CONCURRENCY=2
# 排障时可临时设为 wasm:debug，用完改回
HIGRESS_COMPONENT_LOG_LEVEL=misc:error
HIGRESS_MEM_LIMIT=2g
HIGRESS_CPUS=2

# --- guard（Compose 层可覆盖项）---
GUARD_JWKS_REFRESH_COOLDOWN_SECONDS=30
GUARD_JWKS_TIMEOUT_SECONDS=5
GUARD_UPSTREAM_BASE_URL=http://mock-api:8000
GUARD_DEV_LOGIN_URL=http://dev-idp:8010/token
GUARD_APPROVAL_TTL_HOURS=72
GUARD_MAX_BODY_BYTES=65536
