# 对话入口（chat 服务）
EVALS_CHAT_URL=http://localhost:8030

# MCP 端点（Higress 网关）
EVALS_MCP_URL=http://localhost:8080/aftersale/mcp

# guard 审批与审计控制台接口
EVALS_GUARD_URL=http://localhost:8020

# 取 token 的命令；评测工具在其后追加 --user <登录名> 与 --ttl <秒>
EVALS_MINT_CMD=docker compose exec -T dev-idp python -m dev_idp.mint

# 重置审批与审计（3.11.4）
EVALS_RESET_GUARD_CMD=docker compose exec -T guard python -m app.reset --yes

# 重置订单数据（3.11.4）
EVALS_RESET_MOCKAPI_CMD=docker compose restart mock-api

# 重置后的就绪等待超时（秒）
EVALS_READY_TIMEOUT_SECONDS=60

# MCP 与 guard 请求超时（秒）
EVALS_HTTP_TIMEOUT_SECONDS=15

# 单个对话轮次超时（秒），略大于 CHAT_DIFY_TIMEOUT_SECONDS
EVALS_CHAT_TIMEOUT_SECONDS=150

# 对话轮次之间的间隔（秒）；模型供应商限流时调大
EVALS_TURN_INTERVAL_SECONDS=0

# LLM 评审模型配置（OpenAI 兼容 /chat/completions；任一为空即不启用评审）
EVALS_JUDGE_BASE_URL=
EVALS_JUDGE_API_KEY=
EVALS_JUDGE_MODEL=

# 运行输出目录（相对 evals/ 或绝对路径）
EVALS_REPORT_DIR=reports/runs
