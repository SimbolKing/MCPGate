# Dify 服务入口（知识库 Service API 基础地址，不含 /v1 后缀）
KB_DIFY_BASE_URL=http://localhost:8088

# Dify 工作区级知识库 API Key（在控制台「知识库 -> API」生成，形如 dataset-...）
KB_DIFY_API_KEY=

# Embedding 模型配置（留空时使用 Dify 工作区默认 Embedding 模型）
# 供应商标识形如 <组织>/<插件>/<供应商>，以 Dify 控制台已安装的模型插件为准
KB_EMBEDDING_PROVIDER=
KB_EMBEDDING_MODEL=

# Rerank 模型配置（留空即不重排；KB_RERANK_MODEL 非空时 sync.py 自动开启重排并将 top_k 设为 6）
KB_RERANK_PROVIDER=
KB_RERANK_MODEL=
