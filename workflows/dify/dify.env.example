# 复制为 workflows/dify/docker/.env（需要 Docker Compose v2.35.0+）
# 仅放需要人工或本项目覆盖的变量，其余沿用 docker/envs/**/*.defaults

# 官方默认 weaviate,postgresql,collaboration 去掉 collaboration（关闭 api_websocket）
COMPOSE_PROFILES=weaviate,postgresql

# 官方必填：请用 `openssl rand -hex 32` 生成 64 位十六进制随机串填入
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=

# 仅绑定本机回环地址，避免占用 80/443
EXPOSE_NGINX_PORT=127.0.0.1:8088
EXPOSE_NGINX_SSL_PORT=127.0.0.1:8444

# 与关闭 api_websocket 配套
ENABLE_COLLABORATION_MODE=false

# 单机演示降低 worker 并发数
CELERY_WORKER_AMOUNT=1

# 避免 worker 任务入口 INFO 日志打印工作流输入（含 user_token）；排障时可临时改 INFO
LOG_LEVEL=WARNING

# 安装模型插件依赖较慢时可填写 PyPI 镜像，如 https://pypi.tuna.tsinghua.edu.cn/simple
PIP_MIRROR_URL=
