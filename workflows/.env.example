# === DSL 渲染参数（render_dsl.py 读取）===
# 供应商标识形如 <组织>/<插件>/<供应商>，以 Dify 控制台安装插件后导出值为准
WORKFLOWS_LLM_PROVIDER=langgenius/openai/openai
WORKFLOWS_LLM_MODEL=gpt-4o
# 路由模型留空时默认与主模型相同
WORKFLOWS_ROUTER_PROVIDER=
WORKFLOWS_ROUTER_MODEL=
# Higress MCP 端点（容器网络内地址）
WORKFLOWS_MCP_URL=http://higress:8080/aftersale/mcp

# === 聊天入口 chat 服务参数（docker compose 读取）===
CHAT_DIFY_BASE_URL=http://dify.internal
# Dify 发布"售后助手"后在"访问 API -> API 密钥"创建（形如 app-...）
CHAT_DIFY_API_KEY=
CHAT_DIFY_TIMEOUT_SECONDS=120
CHAT_JWKS_REFRESH_COOLDOWN_SECONDS=30
CHAT_JWKS_TIMEOUT_SECONDS=5
CHAT_DEV_LOGIN_URL=http://dev-idp:8010/token
CHAT_APPROVAL_CONSOLE_URL=http://localhost:8020/console/
CHAT_LOG_LEVEL=INFO
